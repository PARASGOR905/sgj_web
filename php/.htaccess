# Protect PHP directory
# Only allow specific PHP files to be accessed

# Deny directory listing
Options -Indexes

# Deny access to config and db_connect
<FilesMatch "^(config|db_connect)\.php$">
    Require all denied
</FilesMatch>

# Allow only specific PHP files
<FilesMatch "^(contact_process|download_handler|get_csrf_token)\.php$">
    Require all granted
</FilesMatch>

# Deny all other PHP files
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>
